@model QrTerstDB.Views.ViewModel.GenerateQrViewModels
@{
    ViewData["Title"] = "QrCodeGen";

    string QrCodeImgUrl = Model != null ? Model.QrCodeImgUrl : "";
}
<div class="row">
    <div class="col-lg-6 m-auto">
        <form asp-action="Index" method="post">
            <textarea name="text" class="form-control mb-3" rows="5" placeholder="EnterText"></textarea>
            <button type="submit" class="btn btn-primary">AddQr</button>
        </form>
        @if (QrCodeImgUrl != "")
        {
            <div class="w-50 m-auto">
                <img src="@QrCodeImgUrl" class="img-fluid w-100 h-100 mb-3" />
                <a href="@QrCodeImgUrl" class="btn btn-primary w-100" download="QRCode.png"></a>
            </div>
        }

    </div>
</div>
